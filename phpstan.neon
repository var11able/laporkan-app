parameters:
    level: 6
    paths:
        - app
    excludePaths:
        - app/Views/*
        - app/ThirdParty/*
    bootstrapFiles:
        - vendor/codeigniter4/framework/system/Test/bootstrap.php
    scanDirectories:
        - vendor/codeigniter4/framework/system/Helpers
    tmpDir: build/phpstan
    treatPhpDocTypesAsCertain: false
