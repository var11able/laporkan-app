{
    "name": "laporkan/laporkan-app",
    "description": "Laporkan: layanan pengaduan warga berbasis CodeIgniter 4",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "codeigniter4/framework": "^4.7",
        "codeigniter4/translations": "^4.7"
    },
    "require-dev": {
        "codeigniter/coding-standard": "^1.8",
        "codeigniter/phpstan-codeigniter": "^2.1",
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyze": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
